# Aucun appel LLM n'est effectué sans configuration explicite.
OPENAI_API_KEY=
# Dictée dans « Écrire à Kiosque » : clé gardée uniquement côté serveur.
GRADIUM_API_KEY=
# Choisir deux modèles disponibles sur votre compte, compatibles Responses / Structured Outputs.
SUMMARY_MODEL=gpt-5.4-nano
EDITOR_MODEL=gpt-5.4-mini
# Première consultation d'un nouveau visuel : contrôle Nano, ensuite cache persistant.
IMAGE_REVIEW_ENABLED=true
IMAGE_REVIEW_MODEL=gpt-5.4-nano
WEB_SEARCH_ENABLED=true
# Préparation automatique à 4 h (Europe/Paris) des profils enregistrés.
DAILY_EDITIONS_ENABLED=true
DATABASE_URL=postgresql://broadwai:broadwai@localhost:5432/broadwai
MAX_AGENT_STEPS=10
MAX_SUMMARY_CALLS=48
MAX_WEB_SEARCHES=4
MAX_FETCHES=40
# Temps maximum de récupération préalable d'un lot de textes, avant le choix éditorial.
PREFETCH_TIMEOUT=30
SHORTLIST_SIZE=12
# Usage confirmé + réservations en cours, pas un montant en euros.
MAX_TOKEN_BUDGET=750000
FINAL_TOKEN_RESERVE=30000

MAX_DISCOVERED_ARTICLES=20
MAX_SOURCE_PROPOSALS=2
EDITORIAL_POOL_SIZE=96
MIN_EDITORIAL_SCORE=70
# Actualités : priorité aux dernières 24–72 h, plafond de 7 jours.
MAX_ARTICLE_AGE_DAYS=7
# Résultats scientifiques datés. Les lectures de fond valides n'ont AUCUNE limite d'âge.
MAX_RESEARCH_AGE_DAYS=365

# Adresse exacte du lecteur : développement 5173, production https://kiosque.example/reader/
# Détermine les cookies Secure et les origines CSRF acceptées.
AUTH_PUBLIC_URL=http://127.0.0.1:5173/
AUTH_SESSION_DAYS=30
