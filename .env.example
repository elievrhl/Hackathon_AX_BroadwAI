# Aucun appel LLM n'est effectué sans configuration explicite.
OPENAI_API_KEY=
# Choisir deux modèles disponibles sur votre compte, compatibles Responses / Structured Outputs.
SUMMARY_MODEL=gpt-5.4-nano
EDITOR_MODEL=gpt-5.4-mini
WEB_SEARCH_ENABLED=true
DATABASE_URL=postgresql://broadwai:broadwai@localhost:5432/broadwai
MAX_AGENT_STEPS=6
MAX_SUMMARY_CALLS=24
MAX_WEB_SEARCHES=2
MAX_FETCHES=24
SHORTLIST_SIZE=12
# Limite opérationnelle estimée de tokens réservés par couverture, pas un montant en euros.
MAX_TOKEN_BUDGET=500000

MAX_DISCOVERED_ARTICLES=20
MAX_SOURCE_PROPOSALS=2
EDITORIAL_POOL_SIZE=96
MIN_EDITORIAL_SCORE=70
MAX_ARTICLE_AGE_DAYS=45
# Lectures de fond explicitement reconnues comme durables, pas des nouvelles périmées.
MAX_EVERGREEN_AGE_DAYS=365
